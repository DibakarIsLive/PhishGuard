# Selects api/config/settings/development.py or production.py
DJANGO_ENV=development

SECRET_KEY=change-this-development-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=phishguard
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1000
MONGODB_CONNECT_TIMEOUT_MS=1000
MONGODB_SOCKET_TIMEOUT_MS=1000
MONGODB_RETRY_INTERVAL_SECONDS=30

# API and model limits
API_ANON_RATE=60/min
MAX_URL_LENGTH=2048
MAX_BATCH_SIZE=25
HISTORY_LIMIT=20
LOG_LEVEL=DEBUG
